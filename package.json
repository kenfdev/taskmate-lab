{
  "name": "taskmate-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vp -C apps/api test run",
    "test:ui": "pnpm --filter @taskmate/web test",
    "start": "node --env-file-if-exists=.env apps/api/dist/index.js",
    "worker": "node --env-file-if-exists=.env apps/api/dist/worker.js",
    "check": "vp check"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^24.19.2",
    "vite-plus": "1.3.0"
  }
}
